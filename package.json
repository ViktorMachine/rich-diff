{
  "name": "gpower-rich-diff",
  "version": "1.0.9",
  "description": "可扩展的富文本对比框架，支持多引擎、多类型内容对比、多字段表单布局",
  "main": "dist/rich-diff.umd.js",
  "module": "dist/rich-diff.esm.js",
  "type": "module",
  "sideEffects": true,
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "echo \"请在浏览器中打开 test/index.html 进行测试\"",
    "check:es5": "node scripts/check-es5.js",
    "prepublishOnly": "npm run build && npm run check:es5"
  },
  "keywords": [
    "diff",
    "html-diff",
    "rich-text",
    "compare",
    "version-diff",
    "htmldiff",
    "diffdom"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@lionad/leader-line": "^1.0.0-alpha.0",
    "diff": "^7.0.0",
    "diff-dom": "^5.0.0",
    "htmldiff-js": "^1.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ViktorMachine/rich-diff.git"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "import": "./dist/rich-diff.esm.js",
      "require": "./dist/rich-diff.umd.js",
      "default": "./dist/rich-diff.esm.js"
    }
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "rollup": "^4.9.6"
  }
}
